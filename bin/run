#!/usr/bin/env bash
# herdproof-bun — Bun core-server factory (zero-trust Hono/Elysia server factory). bin/run.
#
# Primary operation: build/typecheck the `@herdproof/core-server` Bun library
# (packages/core-server/src/server/factory.ts → a zero-trust Serve factory).
# This rig builds the factory entry (bundles clean) to surface the op.
#
# Usage: bin/run — build the core-server factory (bun build, dry output to /tmp)
set -euo pipefail
cd "$(dirname "$0")/.."

BUN="${BUN:-$(command -v bun 2>/dev/null || true)}"
for c in "$BUN" /home/toxic/.bun/bin/bun /usr/local/bin/bun /usr/bin/bun; do
  [ -n "$c" ] && [ -x "$c" ] && { BUN="$c"; break; }
done
[ -n "${BUN:-}" ] || { echo "FAIL: bun not found"; exit 1; }

echo "== herdproof-bun run: build core-server factory =="
"$BUN" build packages/core-server/src/server/factory.ts --target=bun --outdir=/tmp/hpb-build 2>&1 \
  || { echo "FAIL: bun build failed"; exit 1; }
echo "OK: core-server factory bundles clean (see /tmp/hpb-build)"