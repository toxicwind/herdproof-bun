#!/usr/bin/env bash
# herdproof-bun — Bun core-server factory. bin/check.
#
# Fast self-test (PASS/FAIL), no run:
#   1. bun is available.
#   2. core-server factory TS source present.
#   3. bun build of the factory entry succeeds (compiles clean).
#   4. moon.yml project present (TypeScript backend lib).
set -euo pipefail
cd "$(dirname "$0")/.."

echo "== herdproof-bun check: start =="
BUN="${BUN:-$(command -v bun 2>/dev/null || true)}"
for c in "$BUN" /home/toxic/.bun/bin/bun /usr/local/bin/bun /usr/bin/bun; do
  [ -n "$c" ] && [ -x "$c" ] && { BUN="$c"; break; }
done
[ -n "${BUN:-}" ] || { echo "FAIL: bun not found"; exit 1; }

F=packages/core-server/src/server/factory.ts
[ -f "$F" ] && echo "OK: $F present" || { echo "FAIL: $F missing"; exit 1; }

if "$BUN" build "$F" --target=bun --outdir=/tmp/hpb-check >/tmp/hpb-check.log 2>&1; then
  echo "OK: bun build of factory compiles clean"
else
  echo "FAIL: bun build failed:"; tail -5 /tmp/hpb-check.log; exit 1
fi

[ -f moon.yml ] && echo "OK: moon.yml present" || echo "WARN: moon.yml missing"
echo "HERDPROOF-BUN CHECK: PASS"
exit 0